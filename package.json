{
	"name": "itunes-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"server:dev": "cd server && npm run dev",
		"server:build": "cd server && npm run build",
		"test": "vitest",
		"server:preview": "cd server && npm run preview",
		"openapi": "npx @openapitools/openapi-generator-cli generate -i api_specs/openApi.yml -g typescript-fetch -o src/api --additional-properties=dateTimeType=string --type-mappings=DateTime=string --type-mappings=Date=string"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/roboto": "^5.2.9",
		"@mui/icons-material": "^7.3.6",
		"@mui/material": "^7.3.6",
		"@reduxjs/toolkit": "^2.11.2",
		"debounce": "^3.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"jsdom": "^27.3.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^7.2.4",
		"vitest": "^4.0.16"
	}
}
