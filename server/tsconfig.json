{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"jsx": "preserve",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@itunes/*": ["src/resources/itunes/*"]
		},
		"noEmit": true
	},
	"include": ["index.ts", "src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", "src/generated"]
}
